# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# Keep Navigation Compose type-safe @Serializable routes and their serializers
-keep,includedescriptorclasses class com.huaman.bible_hymns_choruses.core.navigation.** { *; }

# Keep DataStore enum names used with valueOf()
-keepclassmembers enum com.huaman.bible_hymns_choruses.core.datastore.** {
    public static **[] values();
    public static ** valueOf(java.lang.String);
}

# Keep Room database, entities, and DAOs
-keep class com.huaman.bible_hymns_choruses.data.local.** { *; }